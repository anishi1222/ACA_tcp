        <mxCell id="deployment-note" value="&lt;b&gt;デプロイ順序とイメージの扱い&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1. azd provision: Bicep で基盤とアプリを作成&lt;br&gt;   初回のみ MCR の bootstrapImage を使用&lt;br&gt;2. azd deploy: ACR Tasks で build / push し、&lt;br&gt;   本アプリの新リビジョンを作成&lt;br&gt;3. 再 provision: appAExists / appBExists=true なら&lt;br&gt;   デプロイ済みのイメージを維持&lt;br&gt;&lt;br&gt;仮イメージ: mcr.microsoft.com/azuredocs/&lt;br&gt;containerapps-helloworld:latest&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3F6F9;strokeColor=#C5D2DC;align=left;verticalAlign=middle;spacing=18;fontSize=19;fontColor=#31546F;" vertex="1" parent="delivery-rg"><mxGeometry x="40" y="490" width="540" height="300" as="geometry"/></mxCell>
        <mxCell id="diagnostics" value="&lt;b&gt;Azure Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;環境ごとの診断設定&lt;br&gt;send-to-log-analytics&lt;br&gt;categoryGroup: allLogs&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F8F3;strokeColor=#65A97F;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=78;spacingRight=9;fontSize=17;fontColor=#17324D;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="delivery-rg"><mxGeometry x="700" y="690" width="330" height="110" as="geometry"/></mxCell>
