        <mxCell id="registry-label" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;&lt;br&gt;acr&amp;lt;hash&amp;gt;.azurecr.io | Basic&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;publicNetworkAccess: Enabled&lt;br&gt;adminUser / anonymousPull: 無効&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontColor=#17324D;whiteSpace=wrap;" vertex="1" parent="registry"><mxGeometry x="97" y="23" width="315" height="112" as="geometry"/></mxCell>
        <mxCell id="registry-build" value="&lt;b&gt;ACR Tasks / remoteBuild: true&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Dockerfile → Maven → Java 25 JRE&lt;br&gt;linux/amd64 イメージを build / push&lt;br&gt;app-a:&amp;lt;tag&amp;gt; / app-b:&amp;lt;tag&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4D6F1;align=left;verticalAlign=middle;spacingLeft=65;spacingRight=10;fontSize=16;fontColor=#17324D;container=1;collapsible=0;" vertex="1" parent="registry"><mxGeometry x="18" y="153" width="394" height="127" as="geometry"/></mxCell>
