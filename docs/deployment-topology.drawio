        <mxCell id="dns-zone" value="&lt;b&gt;Private DNS Zone (global)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;privatelink.&amp;lt;region&amp;gt;.azurecontainerapps.io&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;VNet B にリンク / registrationEnabled: false&lt;br&gt;DNS ゾーン グループで PE の A レコードを自動登録 (要検証)&lt;br&gt;想定: app-a.&amp;lt;環境 A の defaultDomain&amp;gt; → PE のプライベート IP&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F6F2FC;strokeColor=#9B7BC3;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=95;spacingRight=15;fontSize=18;fontColor=#17324D;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="resource-group">
